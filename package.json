{
  "name": "solid-sonner",
  "type": "module",
  "version": "0.3.0",
  "private": false,
  "packageManager": "pnpm@10.20.0",
  "description": "An opinionated toast component for Solid.",
  "author": "Robert Soriano <sorianorobertc@gmail.com>",
  "license": "MIT",
  "contributors": [],
  "homepage": "https://github.com/wobsoriano/solid-sonner#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wobsoriano/solid-sonner.git"
  },
  "bugs": {
    "url": "https://github.com/wobsoriano/solid-sonner/issues"
  },
  "keywords": [
    "solid"
  ],
  "exports": {
    ".": {
      "solid": {
        "development": "./dist/dev.jsx",
        "import": "./dist/index.jsx"
      },
      "development": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/dev.js"
        }
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {},
  "files": [
    "dist"
  ],
  "browser": {},
  "scripts": {
    "dev": "vite serve dev",
    "build": "tsup",
    "dev:build": "vite build dev",
    "test": "playwright test",
    "prepublishOnly": "pnpm build",
    "update-deps": "pnpm up -Li",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "release": "changeset publish",
    "lint:fix": "eslint . --fix"
  },
  "peerDependencies": {
    "solid-js": "^1.6.0"
  },
  "devDependencies": {
    "@antfu/eslint-config-ts": "^0.43.1",
    "@changesets/cli": "^2.30.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^20.19.37",
    "copy-to-clipboard": "^3.3.3",
    "esbuild": "^0.21.5",
    "esbuild-plugin-solid": "^0.6.0",
    "eslint": "^8.56.0",
    "eslint-plugin-solid": "^0.14.5",
    "highlight.js": "^11.11.1",
    "jsdom": "^24.1.3",
    "solid-js": "^1.9.11",
    "tsup": "^8.5.1",
    "tsup-preset-solid": "^2.2.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-solid": "^2.11.10"
  },
  "eslintConfig": {
    "plugins": [
      "solid"
    ],
    "extends": [
      "@antfu/eslint-config-ts",
      "plugin:solid/typescript"
    ]
  }
}
